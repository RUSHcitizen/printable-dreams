---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import MemberNav from "../components/MemberNav.astro";
import { getAuth } from "../lib/auth";
import { resolveProtectedAccess } from "../lib/authorization";

const { user, supabase } = await getAuth(Astro);
const access = resolveProtectedAccess(user, Astro.url.pathname);
if (!access.allowed) {
  return Astro.redirect(access.redirectTo);
}

const [{ data: profile }, { data: groups }, { data: memberships }] = await Promise.all([
  supabase.from("profiles").select("display_name").eq("id", user!.id).single(),
  supabase.from("groups").select("id, slug, name, description").order("name"),
  supabase.from("group_memberships").select("group_id, status").eq("user_id", user!.id),
]);

const statusByGroupId = new Map((memberships ?? []).map((m) => [m.group_id, m.status]));
const allGroups = groups ?? [];
const myGroups = allGroups.filter((g) => statusByGroupId.has(g.id));
const availableGroups = allGroups.filter((g) => !statusByGroupId.has(g.id));
const displayName = profile?.display_name?.trim() || user!.email;

const statusStyles: Record<string, string> = {
  pending: "bg-accent-50 text-accent-600",
  active: "bg-brand-50 text-brand-700",
  rejected: "bg-slate-100 text-slate-600",
};
---

<BaseLayout title="Dashboard" description="Your Printable Dreams member dashboard.">
  <MemberNav current="dashboard" />

  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      Dashboard
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      Welcome, {displayName}
    </h1>
    <p class="mt-3 text-slate-700">{user!.email}</p>
  </Section>

  <Section background="white">
    <h2 class="font-display text-2xl font-semibold text-slate-900">Quick actions</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="/request-a-print" label="Request a Print" variant="primary" />
      <Button href="/partners" label="Partner With Us" variant="secondary" />
      <Button href="/groups" label="Browse Groups" variant="secondary" />
      <Button href="/profile" label="Edit Profile" variant="secondary" />
    </div>
  </Section>

  <Section background="sand">
    <h2 class="font-display text-2xl font-semibold text-slate-900">Your groups</h2>
    {
      myGroups.length === 0 ? (
        <p class="mt-4 text-slate-600">
          You haven't joined any groups yet — <a href="/groups" class="font-semibold text-brand-700 underline">browse groups</a> to get started.
        </p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {myGroups.map((g) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-card">
              <a href={`/groups/${g.slug}`} class="font-display text-lg font-semibold text-slate-900 hover:text-brand-700">
                {g.name}
              </a>
              <p
                class={`mt-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide ${statusStyles[statusByGroupId.get(g.id) ?? "pending"]}`}
              >
                {statusByGroupId.get(g.id)}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <Section background="white">
    <h2 class="font-display text-2xl font-semibold text-slate-900">Available groups</h2>
    {
      availableGroups.length === 0 ? (
        <p class="mt-4 text-slate-600">You've requested to join every group.</p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {availableGroups.map((g) => (
            <li class="rounded-xl border border-slate-200 p-5 transition-shadow duration-300 shadow-card-hover">
              <p class="font-display text-lg font-semibold text-slate-900">{g.name}</p>
              <p class="mt-2 text-sm text-slate-600">{g.description}</p>
              <a
                href={`/groups/${g.slug}`}
                class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline"
              >
                Learn more <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
