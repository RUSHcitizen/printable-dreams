---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { getAuth } from "../lib/auth";
import { resolveProtectedAccess } from "../lib/authorization";

const { user, supabase } = await getAuth(Astro);
const access = resolveProtectedAccess(user, Astro.url.pathname);
if (!access.allowed) {
  return Astro.redirect(access.redirectTo);
}

const [{ data: profile }, { data: groups }, { data: memberships }] = await Promise.all([
  supabase.from("profiles").select("display_name").eq("id", user!.id).single(),
  supabase.from("groups").select("id, slug, name, description").order("name"),
  supabase.from("group_memberships").select("group_id, status").eq("user_id", user!.id),
]);

const statusByGroupId = new Map((memberships ?? []).map((m) => [m.group_id, m.status]));
const allGroups = groups ?? [];
const myGroups = allGroups.filter((g) => statusByGroupId.has(g.id));
const availableGroups = allGroups.filter((g) => !statusByGroupId.has(g.id));
const displayName = profile?.display_name?.trim() || user!.email;
---

<BaseLayout title="Dashboard" description="Your Printable Dreams member dashboard.">
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Welcome, {displayName}</h1>
    <p class="mt-3 text-slate-700">{user!.email}</p>
  </Section>

  <Section background="white">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Quick actions</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="/profile" label="Edit Profile" variant="secondary" />
      <Button href="/groups" label="Browse Groups" variant="secondary" />
      <Button href="/request-a-print" label="Request a Print" variant="primary" />
      <Button href="/partner" label="Partner With Us" variant="secondary" />
    </div>
  </Section>

  <Section background="muted">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Your groups</h2>
    {
      myGroups.length === 0 ? (
        <p class="mt-4 text-slate-600">You haven't joined any groups yet.</p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {myGroups.map((g) => (
            <li class="rounded-lg border border-slate-200 bg-white p-5">
              <a href={`/groups/${g.slug}`} class="font-semibold text-slate-900 hover:text-brand-700">
                {g.name}
              </a>
              <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">
                {statusByGroupId.get(g.id)}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <Section background="white">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Available groups</h2>
    {
      availableGroups.length === 0 ? (
        <p class="mt-4 text-slate-600">You've requested to join every group.</p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {availableGroups.map((g) => (
            <li class="rounded-lg border border-slate-200 p-5">
              <p class="font-semibold text-slate-900">{g.name}</p>
              <p class="mt-2 text-sm text-slate-600">{g.description}</p>
              <a href={`/groups/${g.slug}`} class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline">
                Learn more →
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
