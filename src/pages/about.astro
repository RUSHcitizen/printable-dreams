---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PlaceholderBlock from "../components/PlaceholderBlock.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { TAGLINE } from "../config/site";
---

<BaseLayout title="About">
  <!-- Intro -->
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">About Printable Dreams</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-700">{TAGLINE}</p>
  </Section>

  <!-- Mission -->
  <Section background="white">
    <SectionHeading eyebrow="Mission" title="What We're Working Toward" />
    <div class="mt-6 max-w-3xl space-y-4 text-slate-700">
      <p>
        We started this organization with one simple idea: that a child's imagination is powerful, and that
        bringing it to life can change the way they see themselves and the world around them. For kids who are
        struggling — whether from hardship, loss, or simply a difficult season of life — that reminder can mean
        everything.
      </p>
      <p>
        Because the moment a child opens that package and holds something they imagined in their own hands,
        something shifts. They feel seen. They feel proud. They feel like their ideas are worth something —
        because they are. Every creation we send is our way of saying: we see you, we believe in you, and you
        matter.
      </p>
    </div>
  </Section>

  <!-- Organization story -->
  <Section background="muted" class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow="Our Story" title="How Printable Dreams Started" />
      <PlaceholderBlock label="Placeholder — organization story pending" class="mt-6">
        <p>The story of how Printable Dreams came to be will go here once it's provided.</p>
      </PlaceholderBlock>
    </div>
    <ImagePlaceholder label="Photo — e.g. the founder, a workspace, or the team at work." aspect="aspect-[4/3]" />
  </Section>

  <!-- Who we serve -->
  <Section background="white">
    <SectionHeading eyebrow="Who We Serve" title="Kids" />
    <div class="mt-6 max-w-3xl rounded-lg border border-slate-200 bg-white p-6">
      <p class="text-slate-700">
        Printable Dreams serves kids — especially kids who are struggling, whether from hardship, loss, or simply
        a difficult season of life.
      </p>
    </div>
  </Section>

  <!-- How 3D printing fits in -->
  <Section background="muted">
    <SectionHeading eyebrow="Our Approach" title="How 3D Printing Fits Into Our Mission" />
    <p class="mt-6 max-w-3xl text-slate-700">
      A child draws something that means something to them — it can be anything: a superhero, an animal, a
      dream, a memory. They submit it through our website, and our team gets to work: we take that drawing,
      design it, and 3D print it into a real, physical keepsake, then ship it straight to their door. 3D
      printing is what makes it possible to turn a child's own drawing into something they can actually hold.
    </p>
  </Section>

  <!-- Future goals -->
  <Section background="white">
    <SectionHeading eyebrow="Looking Ahead" title="Future Goals" />
    <PlaceholderBlock label="Placeholder — pending real content" class="mt-6 max-w-3xl">
      <p>Printable Dreams' future goals will go here once they're provided.</p>
    </PlaceholderBlock>
  </Section>
</BaseLayout>
