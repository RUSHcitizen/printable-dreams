---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PlaceholderBlock from "../components/PlaceholderBlock.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { TAGLINE } from "../config/site";
---

<BaseLayout
  title="About"
  description="Learn about Printable Dreams' mission: turning kids' drawings into real, 3D-printed keepsakes."
>
  <!-- Intro -->
  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      About Us
    </p>
    <h1 class="mt-3 font-display text-5xl font-semibold tracking-tight text-slate-900 sm:text-6xl">
      Printable Dreams
    </h1>
    <p class="mt-4 max-w-prose text-xl text-slate-700">{TAGLINE}</p>
  </Section>

  <!-- Mission -->
  <Section background="white" reveal>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
          Mission
        </p>
        <p class="mt-4 font-display text-3xl font-medium italic leading-snug text-slate-900 sm:text-4xl">
          "A child's imagination is powerful."
        </p>
      </div>
      <div class="space-y-4 text-slate-700 lg:pt-12">
        <p>
          We started this organization with one simple idea: that bringing a child's imagination to life can
          change the way they see themselves and the world around them. For kids who are struggling — whether
          from hardship, loss, or simply a difficult season of life — that reminder can mean everything.
        </p>
        <p>
          Because the moment a child opens that package and holds something they imagined in their own hands,
          something shifts. They feel seen. They feel proud. They feel like their ideas are worth something —
          because they are. Every creation we send is our way of saying: we see you, we believe in you, and you
          matter.
        </p>
      </div>
    </div>
  </Section>

  <!-- Who we serve -->
  <Section background="brand" reveal>
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        Who We Serve
      </p>
      <p class="mt-4 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Kids.</p>
      <p class="mt-4 text-lg text-slate-700">
        Especially kids who are struggling — whether from hardship, loss, or simply a difficult season of life.
      </p>
    </div>
  </Section>

  <!-- How 3D printing fits in -->
  <Section background="white" reveal class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow="Our Approach" title="How 3D Printing Fits Into Our Mission" />
      <p class="mt-6 max-w-prose text-slate-700">
        A child draws something that means something to them — it can be anything: a superhero, an animal, a
        dream, a memory. They submit it through our website, and our team gets to work: we take that drawing,
        design it, and 3D print it into a real, physical keepsake, then ship it straight to their door. 3D
        printing is what makes it possible to turn a child's own drawing into something they can actually hold.
      </p>
    </div>
    <ImagePlaceholder label="A 3D printer at work, or a finished keepsake." aspect="aspect-[4/3]" />
  </Section>

  <!-- Organization story -->
  <Section background="sand" reveal>
    <SectionHeading eyebrow="Our Story" title="How Printable Dreams Started" />
    <PlaceholderBlock label="Coming soon" class="mt-6 max-w-prose">
      <p>The story of how Printable Dreams came to be will go here once it's provided.</p>
    </PlaceholderBlock>
  </Section>

  <!-- Future goals -->
  <Section background="white" reveal>
    <SectionHeading eyebrow="Looking Ahead" title="Future Goals" />
    <PlaceholderBlock label="Coming soon" class="mt-6 max-w-prose">
      <p>Printable Dreams' future goals will go here once they're provided.</p>
    </PlaceholderBlock>
  </Section>
</BaseLayout>
