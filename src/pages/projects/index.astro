---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Projects"
  description="Real projects where a child's drawing became a 3D-printed keepsake."
>
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Projects</h1>
    <p class="mt-4 max-w-prose text-lg text-slate-700">
      A look at drawings we've brought to life. New projects are added as they're completed.
    </p>
  </Section>

  <Section background="white">
    {
      projects.length === 0 ? (
        <EmptyState message="No projects have been published yet. Check back soon." />
      ) : (
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
