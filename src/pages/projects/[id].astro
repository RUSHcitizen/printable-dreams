---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{project.data.title}</h1>
    <dl class="mt-6 grid gap-4 text-sm text-slate-600 sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-slate-900">The problem</dt>
        <dd>{project.data.problem}</dd>
      </div>
      <div>
        <dt class="font-semibold text-slate-900">How 3D printing helped</dt>
        <dd>{project.data.solution}</dd>
      </div>
    </dl>
    <div class="mt-8 space-y-4 text-slate-700">
      <Content />
    </div>
  </article>
</BaseLayout>
