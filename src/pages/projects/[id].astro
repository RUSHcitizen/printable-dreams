---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "../../lib/formatDate";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, date, problem, solution, cover, coverAlt, gallery } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={problem}>
  <Section background="white">
    <article class="mx-auto max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{formatDate(date)}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>

      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            width={960}
            height={640}
            class="mt-8 aspect-[3/2] w-full rounded-lg object-cover"
          />
        )
      }

      <dl class="reveal mt-8 grid gap-6 rounded-xl border border-slate-200 bg-sand-50 p-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-semibold text-slate-900">The problem</dt>
          <dd class="mt-1 text-slate-600">{problem}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-slate-900">How 3D printing helped</dt>
          <dd class="mt-1 text-slate-600">{solution}</dd>
        </div>
      </dl>

      <div class="reveal prose prose-slate mt-8 max-w-none">
        <Content />
      </div>

      {
        gallery.length > 0 && (
          <ul class="mt-10 grid gap-4 sm:grid-cols-2">
            {gallery.map((item) => (
              <li class="reveal-item">
                <Image
                  src={item.src}
                  alt={item.alt}
                  width={480}
                  height={360}
                  class="aspect-[4/3] w-full rounded-lg object-cover"
                />
              </li>
            ))}
          </ul>
        )
      }
    </article>
  </Section>
</BaseLayout>
