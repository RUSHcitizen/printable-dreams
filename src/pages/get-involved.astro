---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PlaceholderBlock from "../components/PlaceholderBlock.astro";
import Button from "../components/Button.astro";

interface Opportunity {
  title: string;
}

// Tentative categories only — not confirmed active programs. Each renders
// with its own placeholder body until real opportunities are confirmed.
const opportunities: Opportunity[] = [
  { title: "Volunteer" },
  { title: "Support a Project" },
  { title: "Spread the Word" },
];
---

<BaseLayout title="Get Involved">
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Get Involved</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-700">
      There are ways to help Printable Dreams beyond requesting a service. The specific opportunities below are
      placeholders pending confirmation.
    </p>
  </Section>

  <Section background="white">
    <SectionHeading title="Ways to Help" />
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        opportunities.map((opportunity) => (
          <li class="rounded-lg border border-slate-200 p-6">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-slate-900">{opportunity.title}</h3>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">
                Pending confirmation
              </span>
            </div>
            <PlaceholderBlock label="Placeholder — details pending" class="mt-4">
              <p>Details on how to {opportunity.title.toLowerCase()} will go here once confirmed.</p>
            </PlaceholderBlock>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section background="muted">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Have another idea?</h2>
      <p class="mt-3 text-slate-600">If you'd like to help in a way not listed here, reach out — we'd love to hear from you.</p>
      <div class="mt-6 flex justify-center">
        <Button href="/contact/" label="Contact Us" variant="primary" />
      </div>
    </div>
  </Section>
</BaseLayout>
