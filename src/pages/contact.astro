---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { CONTACT_EMAIL } from "../config/site";
---

<BaseLayout title="Contact" description="Contact Printable Dreams by email.">
  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      Contact
    </p>
    <h1 class="mt-3 font-display text-5xl font-semibold tracking-tight text-slate-900 sm:text-6xl">Get in Touch</h1>
    <p class="mt-4 max-w-prose text-xl text-slate-700">For general questions, reach us by email.</p>
  </Section>

  <Section background="white" reveal>
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Email</p>
      <p class="mt-2">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="text-lg font-semibold text-brand-700 underline hover:text-brand-800"
        >
          {CONTACT_EMAIL}
        </a>
      </p>

      <div class="mt-10 border-t border-slate-200 pt-8">
        <h2 class="text-xl font-semibold text-slate-900">Requesting a print?</h2>
        <p class="mt-2 max-w-prose text-slate-600">
          Kids and parents requesting a print — including submitting a drawing — use a dedicated form. No account
          needed.
        </p>
        <div class="mt-4">
          <Button href="/request-a-print/" label="Request a Print" variant="primary" />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
