---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DonateButton from "../components/DonateButton.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Support"
  description="Support Printable Dreams' work turning kids' drawings into 3D-printed keepsakes."
>
  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      Support Us
    </p>
    <h1 class="mt-3 font-display text-5xl font-semibold tracking-tight text-slate-900 sm:text-6xl">
      Support Printable Dreams
    </h1>
    <p class="mt-4 max-w-prose text-xl text-slate-700">
      Printable Dreams is completely free for the kids and families who receive a print. This isn't about making
      money — it's about making a difference.
    </p>
    <p class="mt-3 max-w-prose text-slate-600">
      It started with $300 our founder earned helping a vendor at the Redmond Farmers Market — read the
      <a href="/about/" class="font-semibold text-brand-700 underline hover:text-brand-800">full story</a>
      on the About page.
    </p>
  </Section>

  <!-- Donate -->
  <Section background="white" reveal>
    <SectionHeading eyebrow="Donate" title="Financial Support" />
    <div class="mt-4 max-w-2xl">
      <p class="text-slate-600">
        Printable Dreams doesn't have a donation processor connected yet. Once one is set up, the button below
        will link to it directly.
      </p>
      <div class="mt-6">
        <DonateButton />
      </div>
    </div>
  </Section>

  <!-- Non-monetary support -->
  <Section background="sand" reveal>
    <SectionHeading eyebrow="Other Ways to Help" title="Support Without Donating" />
    <p class="mt-4 max-w-prose text-slate-600">
      Money isn't the only way to help. Volunteer, offer a 3D printer, or partner with us instead.
    </p>
    <div class="mt-6">
      <Button href="/get-involved/" label="See How to Get Involved" variant="secondary" />
    </div>
  </Section>

  <!-- Contact -->
  <Section background="white" reveal>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        Questions About Supporting Us?
      </h2>
      <p class="mt-3 text-slate-600">Reach out and we'll be glad to help.</p>
      <div class="mt-6 flex justify-center">
        <Button href="/contact/" label="Contact Us" variant="primary" />
      </div>
    </div>
  </Section>
</BaseLayout>
