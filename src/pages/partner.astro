---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PartnershipButton from "../components/PartnershipButton.astro";
---

<BaseLayout
  title="Partner With Printable Dreams"
  description="Explore partnering with Printable Dreams as an organization."
>
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Partner With Printable Dreams</h1>
    <p class="mt-4 max-w-prose text-lg text-slate-700">
      Interested in partnering with Printable Dreams as an organization? Tell us about it through our
      partnership inquiry form.
    </p>
  </Section>

  <Section background="white">
    <div class="max-w-2xl">
      <PartnershipButton />
      <p class="mt-6 text-sm text-slate-600">
        Individuals looking to get personally involved should see
        <a href="/groups" class="font-semibold text-brand-700 underline hover:text-brand-800">Groups</a>
        instead, or
        <a href="/contact/" class="font-semibold text-brand-700 underline hover:text-brand-800">contact us</a>
        directly.
      </p>
    </div>
  </Section>
</BaseLayout>
