---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { formatDate } from "../../lib/formatDate";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="News and stories from Printable Dreams.">
  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      Blog
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      Stories from Printable Dreams
    </h1>
    <p class="mt-4 max-w-prose text-lg text-slate-700">
      Updates about the people and community partners helping bring kids' ideas to life.
    </p>
  </Section>

  <Section background="white">
    <ul class="grid gap-8 md:grid-cols-2">
      {
        posts.map((post) => (
          <li class="lift group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card shadow-card-hover hover:border-brand-200">
            <a href={`/blog/${post.id}/`} class="focus-ring-inset block">
              {post.data.cover && (
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? ""}
                  width={720}
                  height={480}
                  class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              )}
              <div class="p-6">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  {formatDate(post.data.date)}
                </p>
                <h2 class="mt-2 font-display text-2xl font-semibold text-slate-900">{post.data.title}</h2>
                <p class="mt-3 text-slate-600">{post.data.excerpt}</p>
                <p class="mt-4 text-sm font-semibold text-brand-700">Read the story →</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
