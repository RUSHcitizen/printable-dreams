---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { formatDate } from "../../lib/formatDate";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, excerpt, cover, coverAlt } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={excerpt}>
  <Section background="white">
    <article class="mx-auto max-w-3xl">
      <a href="/blog/" class="text-sm font-semibold text-brand-700 hover:text-brand-800">← All stories</a>
      <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">{formatDate(date)}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>

      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            width={1200}
            height={800}
            class="mt-8 aspect-[3/2] w-full rounded-xl object-cover"
          />
        )
      }

      <div class="prose prose-slate mt-10 max-w-none prose-a:text-brand-700">
        <Content />
      </div>
    </article>
  </Section>
</BaseLayout>
