---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { getAuth } from "../../lib/auth";
import { resolveProtectedAccess } from "../../lib/authorization";

const { user, supabase } = await getAuth(Astro);
const access = resolveProtectedAccess(user, Astro.url.pathname);
if (!access.allowed) {
  return Astro.redirect(access.redirectTo);
}

const [{ data: groups }, { data: memberships }] = await Promise.all([
  supabase.from("groups").select("id, slug, name, description").order("name"),
  supabase.from("group_memberships").select("group_id, status").eq("user_id", user!.id),
]);

const statusByGroupId = new Map((memberships ?? []).map((m) => [m.group_id, m.status]));
---

<BaseLayout title="Groups" description="Groups you can join to help Printable Dreams.">
  <Section background="brand">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Groups</h1>
    <p class="mt-4 max-w-prose text-lg text-slate-700">
      A group is a way to tell Printable Dreams how you'd like to help. Request to join one below — a member of
      Printable Dreams will follow up.
    </p>
  </Section>

  <Section background="white">
    <ul class="grid gap-6 sm:grid-cols-3">
      {
        (groups ?? []).map((g) => (
          <li class="rounded-lg border border-slate-200 p-6">
            <p class="font-semibold text-slate-900">{g.name}</p>
            <p class="mt-2 text-sm text-slate-600">{g.description}</p>
            {statusByGroupId.has(g.id) && (
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-brand-700">
                {statusByGroupId.get(g.id)}
              </p>
            )}
            <a href={`/groups/${g.slug}`} class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline">
              {statusByGroupId.has(g.id) ? "View →" : "Learn more →"}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
