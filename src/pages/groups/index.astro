---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import MemberNav from "../../components/MemberNav.astro";
import { getAuth } from "../../lib/auth";
import { resolveProtectedAccess } from "../../lib/authorization";

const { user, supabase } = await getAuth(Astro);
const access = resolveProtectedAccess(user, Astro.url.pathname);
if (!access.allowed) {
  return Astro.redirect(access.redirectTo);
}

const [{ data: groups }, { data: memberships }] = await Promise.all([
  supabase.from("groups").select("id, slug, name, description").order("name"),
  supabase.from("group_memberships").select("group_id, status").eq("user_id", user!.id),
]);

const statusByGroupId = new Map((memberships ?? []).map((m) => [m.group_id, m.status]));

const statusStyles: Record<string, string> = {
  pending: "bg-accent-50 text-accent-600",
  active: "bg-brand-50 text-brand-700",
  rejected: "bg-slate-100 text-slate-600",
};
---

<BaseLayout title="Groups" description="Groups you can join to help Printable Dreams.">
  <MemberNav current="groups" />

  <Section background="brand">
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      Groups
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      Find Your Group
    </h1>
    <p class="mt-4 max-w-prose text-lg text-slate-700">
      A group is a way to tell Printable Dreams how you'd like to help. Request to join one below — a member of
      Printable Dreams will follow up.
    </p>
  </Section>

  <Section background="white">
    <ul class="grid gap-6 sm:grid-cols-3">
      {
        (groups ?? []).map((g) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6 shadow-card transition-shadow duration-300 shadow-card-hover">
            <p class="font-display text-xl font-semibold text-slate-900">{g.name}</p>
            <p class="mt-2 text-sm text-slate-600">{g.description}</p>
            {statusByGroupId.has(g.id) && (
              <p
                class={`mt-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide ${statusStyles[statusByGroupId.get(g.id) ?? "pending"]}`}
              >
                {statusByGroupId.get(g.id)}
              </p>
            )}
            <a
              href={`/groups/${g.slug}`}
              class="mt-3 flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline"
            >
              {statusByGroupId.has(g.id) ? "View" : "Learn more"} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
