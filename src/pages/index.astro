---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PrintIntro from "../components/PrintIntro.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EmptyState from "../components/EmptyState.astro";
import StepCard from "../components/StepCard.astro";
import PartnerMark from "../components/PartnerMark.astro";
import { SITE_TITLE, CONTACT_EMAIL, PARTNERS } from "../config/site";
import heroKeepsake from "../assets/site/finished-keepsake-windowsill.png";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE}>
  <!-- Scroll-driven intro: a drawing gets printed as you scroll. Sits
       ahead of the hero and collapses to a static illustration band where
       scroll-driven animation isn't available (see PrintIntro.astro). -->
  <PrintIntro />

  <!-- Hero -->
  <Section background="brand" class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        Founded in Sammamish
      </p>
      <h1 class="mt-4 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-slate-900 sm:text-6xl">
        A drawing can become something real.
      </h1>
      <p class="mt-5 max-w-prose text-xl text-slate-700">
        A kid can have an idea, draw it on paper, and think, "I wish this could be real." Printable Dreams turns
        that drawing into an actual 3D-printed keepsake they can hold in their hands.
      </p>
      <p class="mt-3 font-display text-2xl italic text-brand-700">Let's make it real.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/request-a-print/" label="Request a Print" variant="primary" />
        <Button href="/partners/" label="Partner With Us" variant="secondary" />
      </div>
    </div>
    <div class="aspect-[4/3] w-full overflow-hidden rounded-xl shadow-card">
      <Image
        src={heroKeepsake}
        alt="A white 3D-printed articulated animal keepsake resting on a sunlit windowsill."
        width={960}
        height={720}
        class="drift h-full w-full object-cover"
      />
    </div>
  </Section>

  <!-- Mission -->
  <Section background="white" reveal>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
          Our Mission
        </p>
        <p class="mt-4 font-display text-3xl font-medium italic leading-snug text-slate-900 sm:text-4xl">
          "We see you. We believe in you. And you matter."
        </p>
      </div>
      <div class="space-y-4 text-slate-700 lg:pt-12">
        <p>
          Every print is made specifically for one child — no two are ever the same. A kid can draw a dragon, a
          rocket, a garden creature, or anything else their imagination comes up with, and we work to make that
          idea real.
        </p>
        <p>
          It's more than a 3D print. It's a physical reminder that their imagination has value — for kids going
          through difficult medical situations especially, something that belongs to them, that they imagined,
          created, and can hold in their hands.
        </p>
      </div>
    </div>
  </Section>

  <!-- How it works -->
  <Section background="sand" reveal>
    <SectionHeading eyebrow="How It Works" title="From Drawing to Keepsake" align="center" />
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <StepCard number={1} title="Share the Drawing">
        A child draws something that means something to them — a superhero, an animal, a dream, a memory,
        anything at all.
      </StepCard>
      <StepCard number={2} title="Send It to Us">It's submitted through our website.</StepCard>
      <StepCard number={3} title="We Bring It to Life">
        Our team designs it and 3D prints it into a real, physical keepsake.
      </StepCard>
      <StepCard number={4} title="It Arrives">We ship it straight to their door.</StepCard>
    </ol>
  </Section>

  <!-- Who we serve -->
  <Section background="brand" reveal>
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        Who We Serve
      </p>
      <p class="mt-4 font-display text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Kids.</p>
      <p class="mt-4 text-lg text-slate-700">
        Especially kids who are going through difficult medical situations.
      </p>
    </div>
  </Section>

  <!-- From the founder -->
  <Section background="white" reveal class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
    <ImagePlaceholder label="Photo of Atharv, Printable Dreams' founder. Portrait or candid, not posed." aspect="aspect-[4/5]" />
    <div>
      <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        From the Founder
      </p>
      <p class="mt-4 font-display text-2xl font-medium italic leading-snug text-slate-900 sm:text-3xl">
        "I know what it feels like to be a kid going through something difficult."
      </p>
      <p class="mt-4 max-w-prose text-slate-700">
        Atharv Kumaria founded Printable Dreams at 13 years old, right here in Sammamish. He has a heart
        condition himself, and started Printable Dreams because he knows how much a small moment of creativity
        and joy can mean during a hard time.
      </p>
      <div class="mt-6">
        <Button href="/about/" label="Read the Full Story" variant="secondary" />
      </div>
    </div>
  </Section>

  <!-- Projects preview -->
  <Section background="white" reveal>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Case Studies" title="Projects" />
      <Button href="/projects/" label="View All Projects" variant="secondary" />
    </div>
    {
      featuredProjects.length === 0 ? (
        <EmptyState message="No projects have been published yet. Check back soon." class="mt-8" />
      ) : (
        <ul class="mt-8 grid gap-6 sm:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      )
    }
  </Section>

  <!-- Partnerships -->
  <Section background="sand" reveal>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Partnerships"
        title="Working Together"
        description="Printable Dreams doesn't do this work alone."
      />
      <Button href="/partners/" label="Meet Our Partners" variant="secondary" />
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        PARTNERS.map((partner) => (
          <li class="reveal-item">
            <PartnerMark name={partner.name} context={partner.context} />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Get involved -->
  <Section background="white" reveal>
    <SectionHeading
      eyebrow="Join Us"
      title="Get Involved"
      description="Printable Dreams is growing beyond Sammamish, and that takes help. Volunteer, offer a 3D printer, or partner with us."
    />
    <div class="mt-8 flex justify-start">
      <Button href="/get-involved/" label="See How to Help" variant="primary" />
    </div>
  </Section>

  <!-- Support -->
  <Section background="brand" reveal>
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Support Us"
        title="Support Printable Dreams"
        description="A donation option is being set up. In the meantime, you can see what support will look like."
      />
      <div class="lg:text-right">
        <Button href="/support/" label="Learn More" variant="secondary" />
      </div>
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section background="white" reveal>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Questions?</h2>
      <p class="mt-3 text-slate-600">Reach us by email, or visit the contact page for more.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={`mailto:${CONTACT_EMAIL}`} label={CONTACT_EMAIL} variant="primary" />
        <Button href="/contact/" label="Contact Page" variant="secondary" />
      </div>
    </div>
  </Section>
</BaseLayout>
