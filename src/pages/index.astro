---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PlaceholderBlock from "../components/PlaceholderBlock.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import RequestFormButton from "../components/RequestFormButton.astro";
import Button from "../components/Button.astro";
import { SITE_TITLE, CONTACT_EMAIL } from "../config/site";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE}>
  <!-- Hero -->
  <Section background="brand" class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Printable Dreams</h1>
      <p class="mt-4 text-lg text-slate-700">A nonprofit using 3D printing to help kids.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <RequestFormButton />
        <Button href="/about/" label="Learn About Our Mission" variant="secondary" />
      </div>
    </div>
    <ImagePlaceholder
      label="Hero photo — e.g. a project in progress or in use. Recommended: landscape, at least 1200×900."
      aspect="aspect-[4/3]"
    />
  </Section>

  <!-- Mission / organization introduction -->
  <Section background="white">
    <SectionHeading eyebrow="Our Mission" title="Why Printable Dreams Exists" />
    <PlaceholderBlock label="Placeholder — mission statement pending" class="mt-6 max-w-3xl">
      <p>The full mission statement will go here once it's provided.</p>
    </PlaceholderBlock>
  </Section>

  <!-- What we do / who we serve -->
  <Section background="muted" class="grid gap-8 sm:grid-cols-2">
    <div>
      <SectionHeading eyebrow="What We Do" title="Our Work" />
      <PlaceholderBlock label="Placeholder — description pending" class="mt-6">
        <p>A description of Printable Dreams' work will go here once it's provided.</p>
      </PlaceholderBlock>
    </div>
    <div>
      <SectionHeading eyebrow="Who We Serve" title="Kids" />
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-slate-700">Printable Dreams serves kids.</p>
        <p class="mt-2 text-sm text-slate-500 italic">More detail on who we serve is coming soon.</p>
      </div>
    </div>
  </Section>

  <!-- How it works -->
  <Section background="white">
    <SectionHeading eyebrow="How It Works" title="Our Process" />
    <PlaceholderBlock label="Placeholder — process details pending" class="mt-6 max-w-3xl">
      <p>A step-by-step explanation of how Printable Dreams' process works will go here once it's provided.</p>
    </PlaceholderBlock>
  </Section>

  <!-- Request-form CTA -->
  <Section background="brand">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Are you a kid or parent looking for help?
      </h2>
      <p class="mt-3 text-slate-700">
        Printable Dreams is building a request form so kids and parents can ask for a service. It isn't live yet —
        check back soon.
      </p>
      <div class="mt-6 flex justify-center">
        <RequestFormButton />
      </div>
    </div>
  </Section>

  <!-- Projects preview -->
  <Section background="white">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Our Work" title="Projects" />
      <Button href="/projects/" label="View All Projects" variant="secondary" />
    </div>
    {
      featuredProjects.length === 0 ? (
        <div class="mt-8 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
          <p class="text-slate-500">No projects have been published yet. Check back soon.</p>
        </div>
      ) : (
        <ul class="mt-8 grid gap-6 sm:grid-cols-3">
          {featuredProjects.map((project) => (
            <li class="rounded-lg border border-slate-200 p-6 transition-shadow hover:shadow-md">
              <a href={`/projects/${project.id}/`} class="font-semibold text-teal-700 hover:underline">
                {project.data.title}
              </a>
              <p class="mt-2 text-sm text-slate-600">{project.data.problem}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <!-- Get involved -->
  <Section background="muted">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Join Us"
        title="Get Involved"
        description="There are ways to help Printable Dreams beyond requesting a service — details coming soon."
      />
      <div class="lg:text-right">
        <Button href="/get-involved/" label="See How to Help" variant="secondary" />
      </div>
    </div>
  </Section>

  <!-- Support -->
  <Section background="brand">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Support Us"
        title="Support Printable Dreams"
        description="A donation option is being set up. In the meantime, you can see what support will look like."
      />
      <div class="lg:text-right">
        <Button href="/support/" label="Learn More" variant="primary" />
      </div>
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section background="white">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Questions?</h2>
      <p class="mt-3 text-slate-600">Reach us by email, or visit the contact page for more.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={`mailto:${CONTACT_EMAIL}`} label={CONTACT_EMAIL} variant="primary" />
        <Button href="/contact/" label="Contact Page" variant="secondary" />
      </div>
    </div>
  </Section>
</BaseLayout>
