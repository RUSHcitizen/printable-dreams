---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import RequestFormButton from "../components/RequestFormButton.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { SITE_TITLE, TAGLINE, CONTACT_EMAIL } from "../config/site";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE}>
  <!-- Hero -->
  <Section background="brand" class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-slate-900 sm:text-6xl">Printable Dreams</h1>
      <p class="mt-5 max-w-prose text-lg text-slate-700">{TAGLINE}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <RequestFormButton />
        <Button href="/about/" label="Learn About Our Mission" variant="secondary" />
      </div>
    </div>
    <ImagePlaceholder
      label="Hero photo — e.g. a project in progress or in use. Recommended: landscape, at least 1200×900."
      aspect="aspect-[4/3]"
    />
  </Section>

  <!-- Mission / organization introduction -->
  <Section background="white">
    <SectionHeading eyebrow="Our Mission" title="Why Printable Dreams Exists" />
    <div class="mt-6 max-w-prose space-y-4 text-slate-700">
      <p>
        We started this organization with one simple idea: that a child's imagination is powerful, and that
        bringing it to life can change the way they see themselves and the world around them.
      </p>
      <p>
        Because the moment a child opens that package and holds something they imagined in their own hands,
        something shifts. They feel seen. They feel proud. They feel like their ideas are worth something —
        because they are. Every creation we send is our way of saying: we see you, we believe in you, and you
        matter.
      </p>
    </div>
  </Section>

  <!-- What we do / who we serve -->
  <Section background="muted" class="grid gap-8 sm:grid-cols-2">
    <div>
      <SectionHeading eyebrow="What We Do" title="Our Work" />
      <p class="mt-6 max-w-prose text-slate-700">
        A child draws something that means something to them — a superhero, an animal, a dream, a memory,
        anything. We take that drawing, design it, and 3D print it into a real, physical keepsake, then ship it
        straight to their door.
      </p>
    </div>
    <div>
      <SectionHeading eyebrow="Who We Serve" title="Kids" />
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-slate-700">
          Printable Dreams serves kids — especially kids who are struggling, whether from hardship, loss, or
          simply a difficult season of life.
        </p>
      </div>
    </div>
  </Section>

  <!-- How it works -->
  <Section background="white">
    <SectionHeading eyebrow="How It Works" title="Our Process" />
    <ol class="mt-6 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { step: "1", text: "A child draws something that means something to them — anything at all." },
          { step: "2", text: "It's submitted through our website." },
          { step: "3", text: "Our team designs it and 3D prints it into a real, physical keepsake." },
          { step: "4", text: "We ship it straight to their door." },
        ].map((item) => (
          <li class="rounded-lg border border-slate-200 p-5 transition-shadow hover:shadow-md">
            <span class="text-sm font-bold text-brand-700">Step {item.step}</span>
            <p class="mt-2 text-sm text-slate-700">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Request-form CTA -->
  <Section background="brand">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Have a child's drawing to bring to life?
      </h2>
      <p class="mt-3 text-slate-700">
        Kids and parents will be able to submit a drawing through a request form. It isn't live yet — check back
        soon.
      </p>
      <div class="mt-6 flex justify-center">
        <RequestFormButton />
      </div>
    </div>
  </Section>

  <!-- Projects preview -->
  <Section background="white">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Our Work" title="Projects" />
      <Button href="/projects/" label="View All Projects" variant="secondary" />
    </div>
    {
      featuredProjects.length === 0 ? (
        <EmptyState message="No projects have been published yet. Check back soon." class="mt-8" />
      ) : (
        <ul class="mt-8 grid gap-6 sm:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      )
    }
  </Section>

  <!-- Get involved -->
  <Section background="muted">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Join Us"
        title="Get Involved"
        description="There are ways to help Printable Dreams beyond requesting a service — details coming soon."
      />
      <div class="lg:text-right">
        <Button href="/get-involved/" label="See How to Help" variant="secondary" />
      </div>
    </div>
  </Section>

  <!-- Support -->
  <Section background="brand">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Support Us"
        title="Support Printable Dreams"
        description="A donation option is being set up. In the meantime, you can see what support will look like."
      />
      <div class="lg:text-right">
        <Button href="/support/" label="Learn More" variant="primary" />
      </div>
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section background="white">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Questions?</h2>
      <p class="mt-3 text-slate-600">Reach us by email, or visit the contact page for more.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={`mailto:${CONTACT_EMAIL}`} label={CONTACT_EMAIL} variant="primary" />
        <Button href="/contact/" label="Contact Page" variant="secondary" />
      </div>
    </div>
  </Section>
</BaseLayout>
