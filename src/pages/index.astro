---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../config/site";
---

<BaseLayout title={SITE_TITLE}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{SITE_TITLE}</h1>
    <p class="mt-4 max-w-2xl text-slate-600">
      Site scaffolding is up and running. Full homepage content (hero, mission, featured projects) is built in
      Phase 3.
    </p>
  </div>
</BaseLayout>
