---
// Shared page shell: <head> metadata, header, footer, and the main
// landmark every page renders its content into. Every page in src/pages/
// wraps its content in this layout instead of repeating boilerplate.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, PRODUCTION_URL, CONTACT_EMAIL, FOUNDER_NAME } from "../config/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// Only emit a canonical URL / absolute OG URL once a real production
// domain is known (PRODUCTION_URL in site.ts). A canonical pointing at a
// placeholder domain would be worse than none at all.
const canonicalURL = PRODUCTION_URL ? new URL(Astro.url.pathname, PRODUCTION_URL).href : null;

// Organization structured data, built only from confirmed facts in
// site.ts. Fields we don't have (logo, founding date, social profiles)
// are simply omitted rather than invented.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  founder: { "@type": "Person", name: FOUNDER_NAME },
  ...(PRODUCTION_URL ? { url: PRODUCTION_URL } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      The one deliberate network request on every page: Fraunces for
      headings (see global.css `--font-display`). Preconnect + display=swap
      keep it from blocking text render — body copy stays on the system
      font stack and needs no network request at all.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />

    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
