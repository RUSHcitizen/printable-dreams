---
// Scroll-driven intro on the home page — the whole thesis of Printable
// Dreams in one wordless sequence: a kid draws a star, then it gets
// printed layer by layer into something they can hold. The visitor scrolls
// the print head up the object themselves; nothing plays on its own.
//
// Pure CSS, zero JavaScript, in the same idiom as the `.reveal` system in
// global.css: a tall section carries a named `view-timeline`, a sticky
// child is pinned inside it, and every animated part reads its progress
// off that one timeline (so all the pieces stay in lockstep by
// construction). Keyframe percentages — not a dozen `animation-range`s —
// do the sequencing.
//
// It degrades to a plain, finished illustration band (drawing beside a
// completed print, all three captions stacked) wherever scroll-driven
// animations aren't supported or the visitor prefers reduced motion. The
// tall height and the sticky pin only exist inside that guard, so there is
// never a 3-viewport blank gap to scroll past on an unsupported browser.
//
// The star is deliberately the kind of shape a kid actually draws, and it
// prints the way a real FDM printer would: two separate legs first, which
// then join, finishing on the top point.
const STAR =
  "M100,10 L121.2,70.9 L185.6,72.2 L134.2,111.1 L152.9,172.8 L100,136 L47.1,172.8 L65.8,111.1 L14.4,72.2 L78.8,70.9 Z";
---

<section class="print-intro">
  <div class="pi-stage">
    <div class="container-page pi-inner">
      <div class="pi-copy">
        <p class="pi-eyebrow">
          <span class="pi-dot" aria-hidden="true"></span>
          How a dream gets made
        </p>

        <div class="pi-captions">
          <p class="pi-caption pi-caption--1">It starts as a drawing.</p>
          <p class="pi-caption pi-caption--2">Layer by layer, it becomes real.</p>
          <p class="pi-caption pi-caption--3">Something they can hold.</p>
        </div>

        <p class="pi-hint" aria-hidden="true">
          Scroll
          <span class="pi-chevron"></span>
        </p>
      </div>

      <div class="pi-machine" aria-hidden="true">
        <div class="pi-object">
          <!-- The drawing: a hand-drawn outline that draws itself in. -->
          <svg class="pi-svg pi-svg--draw" viewBox="0 0 200 200" fill="none">
            <path
              class="pi-outline"
              d={STAR}
              pathLength="1"
              stroke-width="5"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          </svg>

          <!-- The print: the same shape, filled with layer lines, revealed
               bottom-up as the print head climbs. -->
          <div class="pi-printed">
            <svg class="pi-svg" viewBox="0 0 200 200">
              <defs>
                <pattern id="pi-layer-lines" width="200" height="7" patternUnits="userSpaceOnUse">
                  <rect width="200" height="7" fill="var(--color-brand-500)"></rect>
                  <rect width="200" height="1" y="6" fill="var(--color-brand-800)" opacity="0.35"></rect>
                </pattern>
              </defs>
              <path
                d={STAR}
                fill="url(#pi-layer-lines)"
                stroke="var(--color-brand-700)"
                stroke-width="6"
                stroke-linejoin="round"
              ></path>
            </svg>
          </div>

          <div class="pi-head">
            <span class="pi-nozzle"></span>
          </div>
        </div>

        <div class="pi-bed"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Base styles are the finished, static state — a drawing next to a
   * completed print. Everything below the `@supports` guard is additive.
   */
  .print-intro {
    background-color: var(--color-sand-50);
    border-bottom: 1px solid var(--color-sand-200);
  }

  .pi-inner {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    padding-block: 4rem;
  }

  @media (min-width: 1024px) {
    .pi-inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 5rem;
    }
  }

  .pi-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--color-brand-700);
  }

  .pi-dot {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-accent-500);
  }

  .pi-captions {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .pi-caption {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-brand-900, #0f3d3a);
  }

  /* Only meaningful while the sequence is scrubbable. */
  .pi-hint {
    display: none;
  }

  .pi-machine {
    display: grid;
    justify-items: center;
    width: min(22rem, 70vw);
    margin-inline: auto;
  }

  .pi-object {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .pi-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The pencil outline sits behind the print, offset slightly so both read
     as two separate objects rather than one misaligned one. */
  .pi-svg--draw {
    transform: translate(-7%, -5%) scale(0.92) rotate(-6deg);
  }

  .pi-outline {
    stroke: var(--color-sand-300);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .pi-printed {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 12px 20px rgba(15, 61, 58, 0.18));
  }

  /* A print head hovering over a finished object makes no sense in the
     static fallback — it only appears while the sequence can be scrubbed. */
  .pi-head {
    display: none;
  }

  .pi-bed {
    width: 92%;
    height: 10px;
    margin-top: -2px;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--color-sand-200), var(--color-sand-300));
    box-shadow: 0 10px 18px -10px rgba(15, 61, 58, 0.45);
  }

  /*
   * Enhanced: the pinned, scroll-scrubbed sequence.
   *
   * `.print-intro` carries the timeline; every animated descendant reads
   * the exact same range off it (`contain 0%` → `contain 100%`, i.e. the
   * span during which the sticky stage is pinned), and keyframe
   * percentages handle the choreography.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .print-intro {
        height: 320vh;
        view-timeline-name: --print;
      }

      .pi-stage {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        height: 100svh;
        overflow: hidden;
      }

      .pi-inner {
        width: 100%;
        padding-block: 4rem 2rem;
      }

      /*
       * The three lines stay stacked and readable the whole way through —
       * the one you're currently "on" lifts to full weight while the others
       * sit back. Deliberately not a crossfade: an opacity that bottoms out
       * at 0 depends on the timeline's before/after fill behaving, and a
       * caption that vanishes at the edges of the range is worse than one
       * that's merely dim.
       */
      .pi-caption {
        opacity: 0.28;
        animation-name: pi-caption-1;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      .pi-caption--2 {
        animation-name: pi-caption-2;
      }

      .pi-caption--3 {
        animation-name: pi-caption-3;
      }

      @keyframes pi-caption-1 {
        0%,
        26% {
          opacity: 1;
        }
        38%,
        100% {
          opacity: 0.28;
        }
      }

      @keyframes pi-caption-2 {
        0%,
        26% {
          opacity: 0.28;
        }
        38%,
        70% {
          opacity: 1;
        }
        82%,
        100% {
          opacity: 0.28;
        }
      }

      @keyframes pi-caption-3 {
        0%,
        70% {
          opacity: 0.28;
        }
        82%,
        100% {
          opacity: 1;
        }
      }

      /* "Scroll" hint — present only until the sequence is clearly moving. */
      .pi-hint {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-brand-700);
        animation: pi-hint-out linear both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      .pi-chevron {
        width: 0.5rem;
        height: 0.5rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
      }

      @keyframes pi-hint-out {
        0% {
          opacity: 1;
        }
        10%,
        100% {
          opacity: 0;
        }
      }

      /* The drawing draws itself, then dims once the print takes over. */
      .pi-outline {
        stroke-dashoffset: 1;
        animation: pi-draw linear both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-draw {
        0% {
          stroke-dashoffset: 1;
          stroke: var(--color-brand-700);
        }
        26% {
          stroke-dashoffset: 0;
          stroke: var(--color-brand-700);
        }
        46%,
        100% {
          stroke-dashoffset: 0;
          stroke: var(--color-sand-300);
        }
      }

      /* The print itself, revealed bottom-up. The inset percentages are the
         star's actual extent inside the 200x200 viewBox (y 10 → 173), so
         the reveal starts and stops exactly on the shape rather than
         wasting scroll on empty box. */
      .pi-printed {
        clip-path: inset(87% 0 0 0);
        animation: pi-print linear both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-print {
        0%,
        30% {
          clip-path: inset(87% 0 0 0);
        }
        82%,
        100% {
          clip-path: inset(3% 0 0 0);
        }
      }

      /* The print head tracks the top of the printed material exactly. */
      .pi-head {
        display: block;
        position: absolute;
        left: -4%;
        right: -4%;
        top: 87%;
        height: 2px;
        background: var(--color-brand-700);
        border-radius: 9999px;
        animation: pi-head-climb linear both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-head-climb {
        0%,
        30% {
          top: 87%;
          opacity: 1;
        }
        82% {
          top: 3%;
          opacity: 1;
        }
        92%,
        100% {
          top: 3%;
          opacity: 0;
        }
      }

      /* Nozzle sweeping back and forth across the head, the way a real one
         does — the scroll timeline spans all 9 alternating iterations. */
      .pi-nozzle {
        position: absolute;
        top: -0.75rem;
        left: 12%;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 2px 2px 5px 5px;
        background: var(--color-brand-800);
        animation: pi-nozzle-sweep linear both;
        animation-timeline: --print;
        animation-range: contain 30% contain 82%;
        animation-iteration-count: 9;
        animation-direction: alternate;
      }

      @keyframes pi-nozzle-sweep {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(600%);
        }
      }

      /* A small settle once the last layer lands. */
      .pi-machine {
        animation: pi-settle linear both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-settle {
        0%,
        82% {
          transform: scale(1);
        }
        90% {
          transform: scale(1.045);
        }
        96%,
        100% {
          transform: scale(1);
        }
      }
    }
  }
</style>
