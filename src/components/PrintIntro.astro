---
// Scroll-driven intro on the home page — Printable Dreams' whole process in
// three scenes the visitor scrubs through themselves:
//
//   1. A kid draws a robot          (a sketch that draws itself in)
//   2. It's modelled in software    (a CAD window solidifying the shape)
//   3. It's printed                 (layer by layer, on the print bed)
//
// Pure CSS, zero JavaScript, in the same idiom as the `.reveal` system in
// global.css: a tall section carries one named `view-timeline`, a sticky
// child is pinned inside it, and every animated part reads its progress off
// that single timeline — so the three scenes and the caption highlighting
// stay in lockstep by construction. Keyframe percentages do the sequencing
// rather than a dozen separate `animation-range`s.
//
// Note the longhand `animation-*` properties throughout: the `animation`
// shorthand resets `animation-timeline`/`animation-duration`, which quietly
// breaks scroll-driven timing. Don't collapse them.
//
// It degrades to a plain static illustration band — the three scenes side
// by side, all three captions readable — wherever scroll-driven animations
// aren't supported or the visitor prefers reduced motion. The tall height
// and the sticky pin only exist inside that guard, so there is never a
// 3-viewport blank gap to scroll past on an unsupported browser.
//
// The robot is built from plain rounded rects and circles rather than one
// path, so the same geometry can be a pencil sketch, a wireframe, and a
// layer-lined print without three separate drawings to keep in sync.
---

<section class="print-intro">
  <div class="pi-stage">
    <div class="container-page pi-inner">
      <div class="pi-copy">
        <p class="pi-eyebrow">
          <span class="pi-dot" aria-hidden="true"></span>
          How a dream gets made
        </p>

        <ol class="pi-captions">
          <li class="pi-caption pi-caption--1">
            <span class="pi-step">1</span>
            A kid draws a robot.
          </li>
          <li class="pi-caption pi-caption--2">
            <span class="pi-step">2</span>
            We model it in software.
          </li>
          <li class="pi-caption pi-caption--3">
            <span class="pi-step">3</span>
            It becomes something they can hold.
          </li>
        </ol>

        <p class="pi-hint" aria-hidden="true">
          Scroll
          <span class="pi-chevron"></span>
        </p>
      </div>

      <div class="pi-stack" aria-hidden="true">
        <!-- 1. The drawing: paper, and a sketch that draws itself in. -->
        <div class="pi-scene pi-scene--draw">
          <div class="pi-paper">
            <svg class="pi-svg" viewBox="0 0 200 200" fill="none">
              <g
                class="pi-sketch"
                stroke="var(--color-slate-400, #94a3b8)"
                stroke-width="4"
                stroke-linejoin="round"
              >
                <circle class="pi-ink pi-ink--4" cx="100" cy="14" r="8" pathLength="1"></circle>
                <rect class="pi-ink pi-ink--4" x="97" y="18" width="6" height="22" rx="3" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--1" x="66" y="38" width="68" height="52" rx="16" pathLength="1"></rect>
                <circle class="pi-ink pi-ink--4" cx="85" cy="62" r="6" pathLength="1"></circle>
                <circle class="pi-ink pi-ink--4" cx="115" cy="62" r="6" pathLength="1"></circle>
                <rect class="pi-ink pi-ink--4" x="86" y="74" width="28" height="6" rx="3" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--2" x="58" y="92" width="84" height="64" rx="14" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--3" x="34" y="100" width="20" height="44" rx="10" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--3" x="146" y="100" width="20" height="44" rx="10" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--3" x="72" y="152" width="18" height="38" rx="8" pathLength="1"></rect>
                <rect class="pi-ink pi-ink--3" x="110" y="152" width="18" height="38" rx="8" pathLength="1"></rect>
              </g>
            </svg>
          </div>
        </div>

        <!-- 2. The software: the sketch becomes a model. -->
        <div class="pi-scene pi-scene--model">
          <div class="pi-window">
            <div class="pi-titlebar">
              <span class="pi-tab"></span>
              <span class="pi-tab"></span>
              <span class="pi-tab"></span>
              <span class="pi-filename">robot.stl</span>
            </div>
            <div class="pi-canvas">
              <svg class="pi-svg" viewBox="0 0 200 200">
                <g class="pi-model" stroke="var(--color-brand-600)" stroke-width="3" stroke-linejoin="round">
                  <circle cx="100" cy="14" r="8"></circle>
                  <rect x="97" y="18" width="6" height="22" rx="3"></rect>
                  <rect x="66" y="38" width="68" height="52" rx="16"></rect>
                  <circle cx="85" cy="62" r="6"></circle>
                  <circle cx="115" cy="62" r="6"></circle>
                  <rect x="86" y="74" width="28" height="6" rx="3"></rect>
                  <rect x="58" y="92" width="84" height="64" rx="14"></rect>
                  <rect x="34" y="100" width="20" height="44" rx="10"></rect>
                  <rect x="146" y="100" width="20" height="44" rx="10"></rect>
                  <rect x="72" y="152" width="18" height="38" rx="8"></rect>
                  <rect x="110" y="152" width="18" height="38" rx="8"></rect>
                </g>
              </svg>
              <span class="pi-scan"></span>
            </div>
          </div>
        </div>

        <!-- 3. The print: the model, built layer by layer on the bed. -->
        <div class="pi-scene pi-scene--print">
          <div class="pi-machine">
            <div class="pi-object">
              <div class="pi-printed">
                <svg class="pi-svg" viewBox="0 0 200 200">
                  <defs>
                    <pattern id="pi-layer-lines" width="200" height="7" patternUnits="userSpaceOnUse">
                      <rect width="200" height="7" fill="var(--color-brand-500)"></rect>
                      <rect width="200" height="1" y="6" fill="var(--color-brand-800)" opacity="0.35"></rect>
                    </pattern>
                  </defs>
                  <g fill="url(#pi-layer-lines)" stroke="var(--color-brand-700)" stroke-width="4">
                    <circle cx="100" cy="14" r="8"></circle>
                    <rect x="97" y="18" width="6" height="22" rx="3"></rect>
                    <rect x="66" y="38" width="68" height="52" rx="16"></rect>
                    <rect x="58" y="92" width="84" height="64" rx="14"></rect>
                    <rect x="34" y="100" width="20" height="44" rx="10"></rect>
                    <rect x="146" y="100" width="20" height="44" rx="10"></rect>
                    <rect x="72" y="152" width="18" height="38" rx="8"></rect>
                    <rect x="110" y="152" width="18" height="38" rx="8"></rect>
                  </g>
                  <g fill="var(--color-brand-900)">
                    <circle cx="85" cy="62" r="6"></circle>
                    <circle cx="115" cy="62" r="6"></circle>
                    <rect x="86" y="74" width="28" height="6" rx="3"></rect>
                  </g>
                </svg>
              </div>

              <div class="pi-head">
                <span class="pi-nozzle"></span>
              </div>
            </div>

            <div class="pi-bed"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Base styles are the finished, static state: all three scenes laid out
   * side by side, all three captions readable. Everything below the
   * `@supports` guard is additive.
   */
  .print-intro {
    background-color: var(--color-sand-50);
    border-bottom: 1px solid var(--color-sand-200);
  }

  .pi-inner {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    padding-block: 4rem;
  }

  @media (min-width: 1024px) {
    .pi-inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
      padding-block: 5rem;
    }
  }

  .pi-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--color-brand-700);
  }

  .pi-dot {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-accent-500);
  }

  .pi-captions {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .pi-caption {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.95rem + 1.3vw, 1.875rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-brand-900, #0f3d3a);
  }

  .pi-step {
    flex: none;
    align-self: center;
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: var(--color-brand-700);
    font-size: 0.875rem;
    color: white;
  }

  /* Only meaningful while the sequence is scrubbable. */
  .pi-hint {
    display: none;
  }

  /* Static layout: the three scenes read left-to-right as a strip. */
  .pi-stack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .pi-scene {
    min-width: 0;
  }

  .pi-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Scene 1 — paper. */
  .pi-paper {
    padding: 12%;
    border-radius: 0.5rem;
    background: white;
    border: 1px solid var(--color-sand-200);
    box-shadow: var(--shadow-card);
  }

  .pi-ink {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Scene 2 — the modelling window. */
  .pi-window {
    border-radius: 0.625rem;
    overflow: hidden;
    background: white;
    border: 1px solid var(--color-slate-200, #e2e8f0);
    box-shadow: var(--shadow-card);
  }

  .pi-titlebar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.6rem;
    background: var(--color-slate-100, #f1f5f9);
    border-bottom: 1px solid var(--color-slate-200, #e2e8f0);
  }

  .pi-tab {
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 9999px;
    background: var(--color-slate-300, #cbd5e1);
  }

  .pi-filename {
    margin-left: 0.35rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-slate-500, #64748b);
  }

  .pi-canvas {
    position: relative;
    padding: 10%;
    background-color: white;
    background-image:
      linear-gradient(to right, var(--color-slate-100, #f1f5f9) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-slate-100, #f1f5f9) 1px, transparent 1px);
    background-size: 12% 12%;
  }

  .pi-model {
    fill: var(--color-brand-100);
  }

  /* The sweeping build line only makes sense while scrubbing. */
  .pi-scan {
    display: none;
  }

  /* Scene 3 — the print bed. */
  .pi-machine {
    display: grid;
    justify-items: center;
  }

  .pi-object {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .pi-printed {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 12px 20px rgba(15, 61, 58, 0.18));
  }

  /* A print head hovering over a finished object makes no sense in the
     static fallback — it only appears while the sequence can be scrubbed. */
  .pi-head {
    display: none;
  }

  .pi-bed {
    width: 96%;
    height: 8px;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--color-sand-200), var(--color-sand-300));
    box-shadow: 0 10px 18px -10px rgba(15, 61, 58, 0.45);
  }

  /*
   * Enhanced: the pinned, scroll-scrubbed sequence.
   *
   * `.print-intro` carries the timeline; every animated descendant reads
   * the same range off it (`contain 0%` → `contain 100%`, i.e. exactly the
   * span during which the sticky stage is pinned).
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .print-intro {
        height: 360vh;
        view-timeline-name: --print;
      }

      .pi-stage {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        height: 100svh;
        overflow: hidden;
      }

      .pi-inner {
        width: 100%;
        padding-block: 4rem 2rem;
      }

      /*
       * The three lines stay stacked and readable the whole way through —
       * the one you're currently on lifts to full weight while the others
       * sit back. Deliberately not a crossfade: an opacity that bottoms out
       * at 0 depends on the timeline's before/after fill behaving, and a
       * caption that vanishes at the edges of the range is worse than one
       * that's merely dim.
       */
      .pi-caption {
        opacity: 0.3;
        animation-name: pi-caption-1;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      .pi-caption--2 {
        animation-name: pi-caption-2;
      }

      .pi-caption--3 {
        animation-name: pi-caption-3;
      }

      @keyframes pi-caption-1 {
        0%,
        26% {
          opacity: 1;
        }
        36%,
        100% {
          opacity: 0.3;
        }
      }

      @keyframes pi-caption-2 {
        0%,
        26% {
          opacity: 0.3;
        }
        36%,
        58% {
          opacity: 1;
        }
        68%,
        100% {
          opacity: 0.3;
        }
      }

      @keyframes pi-caption-3 {
        0%,
        58% {
          opacity: 0.3;
        }
        68%,
        100% {
          opacity: 1;
        }
      }

      /* "Scroll" hint — present only until the sequence is clearly moving. */
      .pi-hint {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-brand-700);
        animation-name: pi-hint-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      .pi-chevron {
        width: 0.5rem;
        height: 0.5rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
      }

      @keyframes pi-hint-out {
        0% {
          opacity: 1;
        }
        10%,
        100% {
          opacity: 0;
        }
      }

      /*
       * The three scenes stop being a strip and stack in one place, each
       * taking its turn. Scene 3 is the one left standing at the end, so
       * it's the only one whose base opacity is 1 — if the timeline's
       * after-phase fill ever misbehaves, the finished robot is what
       * survives rather than an empty box.
       */
      .pi-stack {
        position: relative;
        grid-template-columns: 1fr;
        gap: 0;
        width: min(24rem, 76vw);
        margin-inline: auto;
        aspect-ratio: 1;
      }

      .pi-scene {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      .pi-scene--draw {
        opacity: 0;
        z-index: 3;
        animation-name: pi-scene-draw;
      }

      .pi-scene--model {
        opacity: 0;
        z-index: 2;
        animation-name: pi-scene-model;
      }

      .pi-scene--print {
        opacity: 1;
        z-index: 1;
        animation-name: pi-scene-print;
      }

      @keyframes pi-scene-draw {
        0%,
        28% {
          opacity: 1;
          transform: scale(1);
        }
        38%,
        100% {
          opacity: 0;
          transform: scale(0.94);
        }
      }

      @keyframes pi-scene-model {
        0%,
        28% {
          opacity: 0;
          transform: scale(1.06);
        }
        38%,
        60% {
          opacity: 1;
          transform: scale(1);
        }
        70%,
        100% {
          opacity: 0;
          transform: scale(0.94);
        }
      }

      @keyframes pi-scene-print {
        0%,
        60% {
          opacity: 0;
          transform: scale(1.06);
        }
        70%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* Scene 1 — the sketch draws itself, roughly in the order a kid
         would: head, body, limbs, then the face and antenna. */
      .pi-ink {
        stroke-dashoffset: 1;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
      }

      .pi-ink--1 {
        animation-name: pi-draw;
        animation-range: contain 1% contain 8%;
      }
      .pi-ink--2 {
        animation-name: pi-draw;
        animation-range: contain 7% contain 14%;
      }
      .pi-ink--3 {
        animation-name: pi-draw;
        animation-range: contain 13% contain 21%;
      }
      .pi-ink--4 {
        animation-name: pi-draw;
        animation-range: contain 20% contain 27%;
      }

      @keyframes pi-draw {
        from {
          stroke-dashoffset: 1;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      /* Scene 2 — the model solidifies as the build line sweeps it. */
      .pi-model {
        fill: transparent;
        animation-name: pi-solidify;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 38% contain 58%;
      }

      @keyframes pi-solidify {
        from {
          fill: transparent;
        }
        to {
          fill: var(--color-brand-100);
        }
      }

      .pi-scan {
        display: block;
        position: absolute;
        left: 4%;
        right: 4%;
        height: 2px;
        border-radius: 9999px;
        background: linear-gradient(90deg, transparent, var(--color-brand-500), transparent);
        animation-name: pi-scan-sweep;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 36% contain 60%;
        animation-iteration-count: 3;
      }

      @keyframes pi-scan-sweep {
        from {
          top: 6%;
        }
        to {
          top: 92%;
        }
      }

      /* Scene 3 — the print, revealed bottom-up. The inset percentages are
         the robot's actual extent inside the 200x200 viewBox (y 6 → 190),
         so the reveal starts and stops exactly on the shape rather than
         wasting scroll on empty box. */
      .pi-printed {
        clip-path: inset(95% 0 0 0);
        animation-name: pi-print;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-print {
        0%,
        68% {
          clip-path: inset(95% 0 0 0);
        }
        93%,
        100% {
          clip-path: inset(2% 0 0 0);
        }
      }

      /* The print head tracks the top of the printed material exactly. */
      .pi-head {
        display: block;
        position: absolute;
        left: -4%;
        right: -4%;
        top: 95%;
        height: 2px;
        background: var(--color-brand-700);
        border-radius: 9999px;
        animation-name: pi-head-climb;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-head-climb {
        0%,
        68% {
          top: 95%;
          opacity: 1;
        }
        93% {
          top: 2%;
          opacity: 1;
        }
        97%,
        100% {
          top: 2%;
          opacity: 0;
        }
      }

      /* Nozzle sweeping back and forth across the head, the way a real one
         does — the scroll timeline spans all 8 alternating iterations. */
      .pi-nozzle {
        position: absolute;
        top: -0.7rem;
        left: 10%;
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 2px 2px 5px 5px;
        background: var(--color-brand-800);
        animation-name: pi-nozzle-sweep;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 68% contain 93%;
        animation-iteration-count: 8;
        animation-direction: alternate;
      }

      @keyframes pi-nozzle-sweep {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(700%);
        }
      }

      /* A small settle once the last layer lands. */
      .pi-machine {
        animation-name: pi-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --print;
        animation-range: contain 0% contain 100%;
      }

      @keyframes pi-settle {
        0%,
        93% {
          transform: scale(1);
        }
        96% {
          transform: scale(1.05);
        }
        99%,
        100% {
          transform: scale(1);
        }
      }
    }
  }
</style>
