---
// Visually marks a block of copy as pending real content: a dashed border
// and muted, italic text so it reads as "not final" at a glance, without
// looking broken. Used anywhere factual/organizational copy hasn't been
// provided yet (mission statement, org story, etc.) — never fill this
// pattern with invented claims.
interface Props {
  label?: string;
  class?: string;
}

const { label = "Placeholder — pending real content", class: className = "" } = Astro.props;
---

<div class={`rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 ${className}`}>
  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">{label}</p>
  <div class="mt-2 italic text-slate-500">
    <slot />
  </div>
</div>
