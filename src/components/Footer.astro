---
import { SITE_TITLE, TAGLINE, NONPROFIT_STATUS, CONTACT_EMAIL, NAV_LINKS, SOCIAL_LINKS } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-sand-50">
  <div class="container-page reveal py-12">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-lg font-semibold text-slate-900">{SITE_TITLE}</p>
        <p class="mt-2 text-sm text-slate-600">{TAGLINE}</p>
        <p class="mt-3 text-sm font-medium text-slate-700">{NONPROFIT_STATUS}</p>
      </div>

      <nav aria-label="Footer">
        <p class="text-sm font-semibold text-slate-900">Explore</p>
        <ul class="mt-2 grid grid-cols-2 gap-x-8 gap-y-2 text-sm sm:flex sm:flex-col">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="link-sweep text-slate-600 hover:text-brand-700">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Take action">
        <p class="text-sm font-semibold text-slate-900">Take Action</p>
        <ul class="mt-2 flex flex-col gap-2 text-sm">
          <li>
            <a href="/request-a-print/" class="link-sweep text-slate-600 hover:text-brand-700">Request a Print</a>
          </li>
          <li>
            <a href="/contact/" class="link-sweep text-slate-600 hover:text-brand-700">Contact</a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="text-sm font-semibold text-slate-900">Contact</p>
        <p class="mt-2 text-sm">
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand-700 underline hover:text-brand-800">
            {CONTACT_EMAIL}
          </a>
        </p>

        {
          SOCIAL_LINKS.length > 0 && (
            <ul class="mt-4 flex gap-4 text-sm">
              {SOCIAL_LINKS.map((link) => (
                <li>
                  <a href={link.href} class="link-sweep text-slate-600 hover:text-brand-700">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <p class="mt-10 border-t border-slate-200 pt-6 text-xs text-slate-500">&copy; {year} {SITE_TITLE}</p>
  </div>
</footer>
