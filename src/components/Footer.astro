---
import { SITE_TITLE, CONTACT_EMAIL, NAV_LINKS } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="text-base font-semibold text-slate-900">{SITE_TITLE}</p>
        <p class="mt-2 text-sm text-slate-600">
          A nonprofit using 3D printing to help kids. Full mission statement coming soon.
        </p>
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm sm:flex sm:flex-col">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-slate-600 hover:text-teal-700">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-sm font-semibold text-slate-900">Contact</p>
        <p class="mt-2 text-sm">
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-teal-700 underline hover:text-teal-800">
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>
    </div>

    <p class="mt-8 border-t border-slate-200 pt-6 text-xs text-slate-500">
      &copy; {year} {SITE_TITLE}
    </p>
  </div>
</footer>
