---
// Shared button/link component. Two states, driven entirely by `href`:
//
// - `href` set    -> renders a real <a>.
// - `href` null    -> renders a disabled, non-interactive <span> instead.
//
// This is the pattern behind both RequestFormButton and DonateButton: a
// call-to-action that depends on a URL we don't have yet should never
// render as a working-looking link to nowhere. Visual classes come from
// lib/buttonStyles so this and SubmitButton.astro can never drift.
import { buttonBase, buttonVariants, type ButtonVariant } from "../lib/buttonStyles";

interface Props {
  href?: string | null;
  label: string;
  disabledLabel?: string;
  disabledHint?: string;
  variant?: ButtonVariant;
  external?: boolean;
  class?: string;
}

const {
  href = null,
  label,
  disabledLabel = label,
  disabledHint = "Not available yet — check back soon.",
  variant = "primary",
  external = false,
  class: className = "",
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      class={`${buttonBase} ${buttonVariants[variant]} ${className}`}
    >
      {label}
    </a>
  ) : (
    <span
      class={`${buttonBase} cursor-not-allowed bg-slate-200 text-slate-500 ${className}`}
      aria-disabled="true"
      title={disabledHint}
    >
      {disabledLabel}
    </span>
  )
}
