---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">{eyebrow}</p>}
  <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-slate-600">{description}</p>}
</div>
