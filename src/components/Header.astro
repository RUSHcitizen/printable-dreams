---
// Site header: logo, primary nav, and the request-form CTA.
//
// The mobile menu uses a native <details>/<summary> element instead of a
// JS-driven hamburger menu. That gets us open/close, keyboard support, and
// click-outside-to-close behavior for free, with zero JavaScript shipped.
import { SITE_TITLE, NAV_LINKS } from "../config/site";
import RequestFormButton from "./RequestFormButton.astro";

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-slate-900">
      {SITE_TITLE}
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          NAV_LINKS.map((link) => {
            const isCurrent = currentPath === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class="text-sm font-medium text-slate-700 hover:text-brand-700 aria-[current=page]:text-brand-700"
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hidden md:block">
      <RequestFormButton />
    </div>

    <details class="relative md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center rounded-md border border-slate-300 px-3 text-sm font-medium text-slate-700"
      >
        Menu
      </summary>
      <div class="mobile-menu-panel absolute right-0 z-10 mt-2 w-56 rounded-md border border-slate-200 bg-white p-4 shadow-lg">
        <ul class="flex flex-col gap-1">
          {
            NAV_LINKS.map((link) => {
              const isCurrent = currentPath === link.href;
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent ? "page" : undefined}
                    class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700 aria-[current=page]:text-brand-700"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mt-3 border-t border-slate-200 pt-4">
          <RequestFormButton class="w-full" />
        </div>
      </div>
    </details>
  </div>
</header>
