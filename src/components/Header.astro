---
// Site header: logo, primary nav, auth-state nav, and the "Request a Print"
// CTA.
//
// Both auth states (signed-out and signed-in) are rendered into the static
// HTML on every page — including fully static public ones — and toggled by
// a small inline script that checks /api/session client-side (see bottom of
// file). This is the one deliberate exception to "zero JS on public pages":
// the alternative (making every page on-demand just so Header can check the
// session server-side) would remove prerendering from the entire site.
// Signed-out is shown by default (correct for the overwhelming majority of
// page loads), then swapped to signed-in a moment later if a session
// exists — see README "Architecture" for the full reasoning.
//
// The mobile menu (both auth states) uses a native <details>/<summary>
// element instead of a JS-driven hamburger menu — keyboard support and
// click-outside-to-close for free, zero additional JavaScript.
import { SITE_TITLE, NAV_LINKS } from "../config/site";
import Button from "./Button.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a href="/" class="font-display text-xl font-semibold tracking-tight text-slate-900">
      {SITE_TITLE}
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          NAV_LINKS.map((link) => {
            const isCurrent = currentPath === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class="link-sweep text-sm font-medium text-slate-700 hover:text-brand-700 aria-[current=page]:text-brand-700"
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <div data-auth="signed-out" class="flex items-center gap-3">
        <a href="/signin" class="text-sm font-medium text-slate-700 hover:text-brand-700">Sign In</a>
        <Button href="/signup" label="Join Printable Dreams" variant="secondary" />
      </div>

      <details data-auth="signed-in" hidden class="relative">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-md border border-slate-300 px-3 text-sm font-medium text-slate-700"
        >
          Account
        </summary>
        <div class="mobile-menu-panel absolute right-0 z-10 mt-2 w-48 rounded-md border border-slate-200 bg-white p-2 shadow-lg">
          <ul class="flex flex-col">
            <li><a href="/dashboard" class="block rounded px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Dashboard</a></li>
            <li><a href="/groups" class="block rounded px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Groups</a></li>
            <li><a href="/profile" class="block rounded px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Profile</a></li>
            <li><a href="/signout" class="block rounded px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Sign Out</a></li>
          </ul>
        </div>
      </details>

      <Button href="/request-a-print/" label="Request a Print" variant="primary" />
    </div>

    <details class="relative md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center rounded-md border border-slate-300 px-3 text-sm font-medium text-slate-700"
      >
        Menu
      </summary>
      <div class="mobile-menu-panel absolute right-0 z-10 mt-2 w-64 rounded-md border border-slate-200 bg-white p-4 shadow-lg">
        <ul class="flex flex-col gap-1">
          {
            NAV_LINKS.map((link) => {
              const isCurrent = currentPath === link.href;
              return (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent ? "page" : undefined}
                    class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700 aria-[current=page]:text-brand-700"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div data-auth="signed-out" class="mt-3 flex flex-col gap-1 border-t border-slate-200 pt-3">
          <a href="/signin" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Sign In</a>
          <a href="/signup" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Join Printable Dreams</a>
        </div>

        <div data-auth="signed-in" hidden class="mt-3 flex flex-col gap-1 border-t border-slate-200 pt-3">
          <a href="/dashboard" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Dashboard</a>
          <a href="/groups" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Groups</a>
          <a href="/profile" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Profile</a>
          <a href="/signout" class="flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-brand-700">Sign Out</a>
        </div>

        <div class="mt-3 border-t border-slate-200 pt-3">
          <Button href="/request-a-print/" label="Request a Print" variant="primary" class="w-full" />
        </div>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    fetch("/api/session", { credentials: "same-origin" })
      .then(function (res) {
        return res.ok ? res.json() : null;
      })
      .then(function (data) {
        if (!data || !data.signedIn) return;
        document.querySelectorAll('[data-auth="signed-out"]').forEach(function (el) {
          el.setAttribute("hidden", "");
        });
        document.querySelectorAll('[data-auth="signed-in"]').forEach(function (el) {
          el.removeAttribute("hidden");
        });
      })
      .catch(function () {
        /* Network hiccup: leave the signed-out state showing. */
      });
  })();
</script>
