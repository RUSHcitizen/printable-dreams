---
// One step in the "How It Works" process. A numbered badge + short title +
// the factual description — used to turn the existing process copy into a
// visual sequence instead of a paragraph.
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<li class="reveal-item relative rounded-xl border border-slate-200 bg-white p-6 shadow-card transition-shadow duration-300 shadow-card-hover">
  <span
    class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-700 font-display text-lg font-semibold text-white"
  >
    {number}
  </span>
  <p class="mt-4 font-display text-lg font-semibold text-slate-900">{title}</p>
  <p class="mt-2 text-sm text-slate-600">
    <slot />
  </p>
</li>
