---
// Consistent "nothing here yet" state, used wherever a content collection
// might legitimately be empty (e.g. no projects published yet). Distinct
// from PlaceholderBlock, which marks *missing copy on a page that exists*
// rather than an empty list.
interface Props {
  message: string;
  class?: string;
}

const { message, class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-slate-200 bg-sand-50 p-10 text-center ${className}`}>
  <p class="text-slate-600">{message}</p>
</div>
