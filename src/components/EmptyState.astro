---
// Consistent "nothing here yet" state, used wherever a content collection
// might legitimately be empty (e.g. no projects published yet). This is
// about an empty *list*, not missing copy: where real content hasn't been
// provided, the section is left out entirely rather than shipped as a
// visible "coming soon" gap.
interface Props {
  message: string;
  class?: string;
}

const { message, class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-slate-200 bg-sand-50 p-10 text-center ${className}`}>
  <p class="text-slate-600">{message}</p>
</div>
