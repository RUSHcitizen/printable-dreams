      .ds-guide--v {
        left: 9%;
        top: 14%;
        bottom: 14%;
        width: 1px;
      }

      .ds-guide--h {
        left: 20%;
        right: 20%;
        bottom: 9%;
        height: 1px;
      }

      .ds-guide::before,
      .ds-guide::after {
        content: "";
        position: absolute;
        background: var(--color-brand-600);
      }

      .ds-guide--v::before,
      .ds-guide--v::after {
        left: -4px;
        width: 9px;
        height: 1px;
