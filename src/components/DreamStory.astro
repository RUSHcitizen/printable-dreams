      }

      /* Measurement guides — the vocabulary of CAD without imitating any
         particular program, and without inventing numbers. */
      .ds-guide {
        position: absolute;
        background: var(--color-brand-600);
        opacity: 0;
        animation-name: ds-fade-guides;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
