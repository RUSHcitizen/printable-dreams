      .ds-guide--v::before {
        top: 0;
      }
      .ds-guide--v::after {
        bottom: 0;
      }

      .ds-guide--h::before,
      .ds-guide--h::after {
        top: -4px;
        width: 1px;
        height: 9px;
      }
      .ds-guide--h::before {
        left: 0;
      }
      .ds-guide--h::after {
        right: 0;
      }

      @keyframes ds-fade-guides {
        0%,
        48% {
          opacity: 0;
        }
        54%,
        60% {
          opacity: 0.75;
        }
        66%,
        100% {
          opacity: 0;
        }
      }

      /* --- the robot --------------------------------------------------
         Fades up as edges lifting off the drawing, turns while it's being
         modelled, then settles onto the desk at the end next to the paper
         it came from. */
      .ds-bot {
        --bot-end: translate(32%, 27%) scale(0.44);
        position: absolute;
        inset: 7%;
        z-index: 5;
        aspect-ratio: auto;
        transform-style: preserve-3d;
        will-change: transform, opacity;
        animation-name: ds-bot-move, ds-bot-in;
        animation-timing-function: linear, linear;
        animation-fill-mode: both, both;
        animation-timeline: --dream, --dream;
        animation-range: contain 0% contain 100%, contain 0% contain 100%;
      }

      @keyframes ds-bot-in {
        0%,
        31% {
          opacity: 0;
        }
        40%,
        100% {
          opacity: 1;
        }
      }

      /* Every keyframe carries the same function list — translate, scale,
         rotateY — so they interpolate componentwise. `--bot-end` supplies
         the translate and scale halves of the final pose. */
      @keyframes ds-bot-move {
        0%,
        31% {
          transform: translate(0, 3%) scale(1) rotateY(0deg);
        }
        /* lifting off the page */
        40%,
        52% {
          transform: translate(0, 0) scale(1) rotateY(0deg);
        }
        /* turned, so you can read it as a solid object */
        58% {
          transform: translate(0, 0) scale(1) rotateY(-14deg);
        }
        64% {
          transform: translate(0, 0) scale(1) rotateY(10deg);
        }
        72%,
        90% {
          transform: translate(0, 0) scale(1) rotateY(0deg);
        }
        96% {
          transform: var(--bot-end) rotateY(-10deg);
        }
        100% {
          transform: var(--bot-end) rotateY(-2deg);
        }
      }

      /* Depth. The offset copy slides out from behind the silhouette at the
         moment the flat drawing is supposed to become dimensional. */
      .ds-bot-extrude {
        transform: translate(0, 0);
        animation-name: ds-extrude;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-extrude {
        0%,
        42% {
          transform: translate(0, 0);
          opacity: 0;
        }
        52%,
        62% {
          transform: translate(1.2%, 1%);
          opacity: 1;
        }
        /* Out of the way while the model is opened up, so daylight shows
           between the layers instead of a solid body behind them. */
        68%,
        72% {
          transform: translate(1.2%, 1%);
          opacity: 0;
        }
        78%,
        100% {
          transform: translate(1.2%, 1%);
          opacity: 1;
        }
      }

      /* The pencil lines become edges, hold as a wireframe, and stay on as
         the object's outline — with the bands carrying material only, this
         layer is doing all of the edge definition. */
      .ds-bot-wire {
        opacity: 0;
        animation-name: ds-wire;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-wire {
        0%,
        32% {
          opacity: 0;
        }
        40%,
        48% {
          opacity: 1;
        }
        54%,
        62% {
          opacity: 0.55;
        }
        /* The outline is one whole silhouette, so it can't follow the bands
           when they separate — it steps aside instead of hanging in the air
           around an exploded model. */
        68%,
        72% {
          opacity: 0.1;
        }
        78% {
          opacity: 0.55;
        }
        82%,
        92% {
          opacity: 0.45;
        }
        97%,
        100% {
          opacity: 0.55;
        }
      }

      /* The material. Fades in as the model solidifies, drops away while
         the printer takes over, then fills back up from the first layer to
         the last. */
      .ds-bot-fill {
        opacity: 0;
        clip-path: inset(0 0 0 0);
        animation-name: ds-fill-in, ds-print;
        animation-timing-function: linear, linear;
        animation-fill-mode: both, both;
        animation-timeline: --dream, --dream;
        animation-range: contain 0% contain 100%, contain 0% contain 100%;
      }

      @keyframes ds-fill-in {
        0%,
        44% {
          opacity: 0;
        }
        52%,
        74% {
          opacity: 1;
        }
        77%,
        78% {
          opacity: 0;
        }
        81%,
        100% {
          opacity: 1;
        }
      }

      /* The inset percentages are the robot's real extent in the 240x272
         viewBox (y 16 → 258), so the build starts and stops exactly on the
         object rather than wasting scroll on empty frame. */
      @keyframes ds-print {
        0%,
        76% {
          clip-path: inset(0 0 0 0);
        }
        78%,
        79% {
          clip-path: inset(95% 0 0 0);
        }
        93%,
        100% {
          clip-path: inset(4% 0 0 0);
        }
      }

      /* The slice. Ten bands of one silhouette: contiguous at rest, spread
         apart so you can see it is made of layers, then closed back up. */
      .ds-band {
        animation-name: ds-slice;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-slice {
        0%,
        62% {
          transform: translateY(0);
        }
        68%,
        72% {
          transform: translateY(calc(var(--i) * -4px));
        }
        78%,
        100% {
          transform: translateY(0);
        }
      }

      /* The face is inside the clipped material, so it prints along with
         everything else; it only steps aside for the slicing beat. */
      .ds-bot-face {
        animation-name: ds-face;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-face {
        0%,
        64% {
          opacity: 1;
        }
        69%,
        73% {
          opacity: 0;
        }
        78%,
        100% {
          opacity: 1;
        }
      }

      /* --- the printer ------------------------------------------------
         Frame, bed and spool are static and arrive as one piece. The
         gantry is separate so it can ride the top of the material. */
      .ds-printer {
        display: block;
        position: absolute;
        inset: 0;
        z-index: 2;
        animation-name: ds-printer-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-printer-in {
        0%,
        72% {
          opacity: 0;
          translate: 0 7%;
        }
        80%,
        94% {
          opacity: 1;
          translate: 0 0;
        }
        99%,
        100% {
          opacity: 0;
          translate: 0 4%;
        }
      }

      /* The spool turns while filament is being laid down. */
      .ds-spool {
        transform-origin: 48px 14px;
        animation-name: ds-spool;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 79% contain 93%;
        animation-iteration-count: 3;
      }

      @keyframes ds-spool {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      /* The gantry beam sits at the top of a full-height track, so moving
         it is a `translate` rather than an animated `top`. The track spans
         exactly the printed object's extent, which is what keeps the nozzle
         on the top layer instead of near it. */
      .ds-gantry-track {
        display: block;
        position: absolute;
        left: 6.5%;
        right: 6.5%;
        top: 10%;
        bottom: 11%;
        z-index: 6;
        animation-name: ds-gantry-fade;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-gantry-fade {
        0%,
        76% {
          opacity: 0;
        }
        80%,
        95% {
          opacity: 1;
        }
        99%,
        100% {
          opacity: 0;
        }
      }

      .ds-gantry {
        position: absolute;
        inset: 0;
        will-change: transform;
        animation-name: ds-gantry;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-gantry {
        0%,
        79% {
          translate: 0 100%;
        }
        93%,
        100% {
          translate: 0 0;
        }
      }

      .ds-beam {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 5px;
        border-radius: 3px;
        background: var(--color-brand-900);
      }

      .ds-carriage {
        position: absolute;
        top: 0;
        left: 3%;
        width: 13%;
        height: 15px;
        border-radius: 3px;
        background: var(--color-brand-700);
        animation-name: ds-carriage;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 80% contain 93%;
        animation-iteration-count: 10;
        animation-direction: alternate;
      }

      /* The nozzle, hanging off the carriage onto the top layer. */
      .ds-carriage::after {
        content: "";
        position: absolute;
        bottom: -7px;
        left: 50%;
        margin-left: -5px;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 7px solid var(--color-brand-900);
      }

      @keyframes ds-carriage {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(560%);
        }
      }

      /* --- phones -----------------------------------------------------
         The story is the same; the frame just gets more of the screen and
