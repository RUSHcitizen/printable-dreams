      /* The sketch draws itself on, in the order a kid draws: head, body,
         arms, legs, face, details, then one last flourish. */
      .ds-ink {
        stroke-dashoffset: 1;
        animation-name: ds-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
      }

      .ds-ink--1 {
        animation-range: contain 4% contain 8%;
      }
      .ds-ink--2 {
        animation-range: contain 7.5% contain 11.5%;
      }
      .ds-ink--3 {
        animation-range: contain 11% contain 15%;
      }
      .ds-ink--4 {
        animation-range: contain 14.5% contain 18%;
      }
      .ds-ink--5 {
        animation-range: contain 17.5% contain 21%;
      }
      .ds-ink--6 {
        animation-range: contain 20.5% contain 24%;
      }
      .ds-ink--7 {
        animation-range: contain 23.5% contain 27%;
      }

      @keyframes ds-draw {
        from {
          stroke-dashoffset: 1;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      /* --- the pencil -------------------------------------------------
         `.ds-pencil` is the full size of the drawing area with the pencil
         art anchored at its top-left corner, so translating it by a
         percentage moves the pencil TIP to that point of the paper. The
         waypoints below are the centres of each group of strokes, in the
         order they're drawn. */
      .ds-pencil-track {
        display: block;
        position: absolute;
        inset: 7%;
        pointer-events: none;
      }

      .ds-pencil {
        position: absolute;
        inset: 0;
        opacity: 0;
        animation-name: ds-pencil-move, ds-pencil-fade;
        animation-timing-function: linear, linear;
        animation-fill-mode: both, both;
        animation-timeline: --dream, --dream;
        animation-range: contain 0% contain 100%, contain 0% contain 100%;
      }

      .ds-pencil-art {
        position: absolute;
        left: 0;
        top: 0;
        width: 12%;
        height: auto;
        aspect-ratio: 40 / 152;
        overflow: visible;
        /* Put the graphite tip on the anchor point, then lean the pencil
           about that same tip so it stays put as the hand moves. */
        translate: -50% -100%;
        rotate: 26deg;
        transform-origin: 50% 100%;
        filter: drop-shadow(0 6px 6px rgba(80, 60, 30, 0.28));
      }

      @keyframes ds-pencil-move {
        /* Starts near the kid's hand rather than mid-air, so the first
           frame reads as a pencil about to be put to paper. */
        0%,
        3% {
          translate: 22% 72%;
        }
        5.5% {
          translate: 50% 33%;
        }
        9.5% {
          translate: 50% 65%;
        }
        13% {
          translate: 21% 67%;
        }
        16% {
          translate: 50% 86%;
        }
        19% {
          translate: 49% 34%;
        }
        22% {
          translate: 52% 22%;
        }
        25% {
          translate: 85% 23%;
        }
        27% {
          translate: 94% 4%;
        }
        32%,
        100% {
          translate: 115% -14%;
        }
      }

      @keyframes ds-pencil-fade {
        0%,
        1% {
          opacity: 0;
        }
        3%,
        27% {
          opacity: 1;
        }
        31%,
        100% {
          opacity: 0;
        }
      }

      /* --- the workspace ---------------------------------------------- */
      .ds-work {
        display: block;
        position: absolute;
        inset: -6%;
        z-index: 0;
        animation-name: ds-fade-work;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --dream;
        animation-range: contain 0% contain 100%;
      }

      @keyframes ds-fade-work {
        0%,
        40% {
          opacity: 0;
        }
        48%,
        62% {
          opacity: 1;
        }
        70%,
        100% {
          opacity: 0;
