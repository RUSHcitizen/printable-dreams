---
// The "kids/parents request services" call-to-action used in the header
// and on several pages. Whether it's a real link or a disabled placeholder
// is driven entirely by SERVICE_REQUEST_FORM_URL in src/config/site.ts —
// nothing here needs to change once the real form URL is added.
import Button from "./Button.astro";
import { SERVICE_REQUEST_FORM_URL } from "../config/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<Button
  href={SERVICE_REQUEST_FORM_URL}
  label="Request Services"
  disabledLabel="Request Form Coming Soon"
  disabledHint="The request form isn't live yet — check back soon."
  external
  class={className}
/>
